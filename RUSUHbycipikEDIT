-- Fungsi Cari Player
local function getPlayer(name)
	local lowerName = string.lower(name)
	for _, p in pairs(Players:GetPlayers()) do
		local lowerPlayer = string.lower(p.Name)
		if string.find(lowerPlayer, lowerName) then
			return p
		elseif string.find(string.lower(p.DisplayName), lowerName) then
			return p
		end
	end
end

-- Auto Refresh & List Player dengan Gambar Avatar & Nama Sendiri
local function updatePlayerList()
	for _, child in pairs(PlayerListFrame:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end
	
	for _, p in pairs(Players:GetPlayers()) do
		local pBtn = Instance.new("TextButton")
		pBtn.Parent = PlayerListFrame
		pBtn.Size = UDim2.new(1, 0, 0, 32)
		pBtn.BackgroundColor3 = Color3.fromRGB(60, 10, 10)
		pBtn.BackgroundTransparency = 0.4
		pBtn.Font = Enum.Font.GothamSemibold
		pBtn.Text = "       " .. p.Name -- Spasi untuk memberi ruang ikon avatar
		pBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		pBtn.TextSize = 14
		pBtn.TextXAlignment = Enum.TextXAlignment.Left
		
		local corner = Instance.new("UICorner", pBtn)
		corner.CornerRadius = UDim.new(0, 4)
		
		-- Memuat Avatar / Thumbnail Player
		local icon = Instance.new("ImageLabel")
		icon.Parent = pBtn
		icon.BackgroundTransparency = 1
		icon.Position = UDim2.new(0, 2, 0.1, 0)
		icon.Size = UDim2.new(0, 26, 0, 26)
		
		pcall(function()
			local content, isReady = Players:GetUserThumbnailAsync(p.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size42x42)
			icon.Image = content
		end)
		
		pBtn.MouseButton1Click:Connect(function()
			player = p
			Box.Text = p.Name
			PlayerListFrame.Visible = false
			print("Player selected from list:", p.Name)
		end)
	end
	PlayerListFrame.CanvasSize = UDim2.new(0, 0, 0, UIListLayout.AbsoluteContentSize.Y)
end

Players.PlayerAdded:Connect(updatePlayerList)
Players.PlayerRemoving:Connect(updatePlayerList)
task.spawn(updatePlayerList)

-- Script Asli TextBox Input Focus Lost
Box.FocusLost:Connect(function(enterPressed)
	if enterPressed then
		player = getPlayer(Box.Text)
		if player then
			Box.Text = player.Name
			print("Player found:", player.Name)
		else
			print("Player not found")
		end
	end
end)

